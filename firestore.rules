rules_version = '2';
// Full Firestore ruleset for project `rendezvous-now` (shared by the nikah invite and the bkk trip).
// Paste the whole file into Firebase console → Firestore → Rules → Publish.
// Anything not matched below is denied. The Firebase console itself ignores these rules,
// so the couple can still see every document there.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Bangkok trip planner (unchanged) ----
    match /trips/bkk-2026/{doc=**} {
      allow read, write: if request.auth != null && request.auth.token.email in [
        "j6rockz@gmail.com",
        "ferinakhansanabilah@gmail.com"
      ];
    }

    // ---- Nikah invite ----
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    // Public guestbook: anyone can add one wish and read the latest 40.
    // No edits, no deletes, no single-document reads, no bulk dumps.
    match /wishes/{id} {
      allow list: if request.query.limit <= 40;
      allow create: if request.resource.data.keys().hasOnly(
                         ['name', 'attending', 'guests', 'message', 'source', 'submitted_at'])
                    && request.resource.data.keys().hasAll(['name', 'attending', 'guests', 'source', 'submitted_at'])
                    && str(request.resource.data.name, 1, 150)
                    && request.resource.data.attending in ['yes', 'no']
                    && request.resource.data.guests is int
                    && request.resource.data.guests >= 0 && request.resource.data.guests <= 10
                    && (!('message' in request.resource.data) || str(request.resource.data.message, 0, 500))
                    && request.resource.data.source in ['v3', 'v4']
                    && request.resource.data.submitted_at == request.time;
    }

    // Phone numbers: write-only. Nobody can read them through the website or the API.
    match /rsvp_contacts/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'phone', 'source', 'submitted_at'])
                    && request.resource.data.keys().hasAll(['name', 'phone', 'source', 'submitted_at'])
                    && str(request.resource.data.name, 1, 150)
                    && request.resource.data.phone is string
                    && request.resource.data.phone.matches('^[0-9+()\\- ]{6,20}$')
                    && request.resource.data.source in ['v3', 'v4']
                    && request.resource.data.submitted_at == request.time;
    }
  }
}
